# =============================================================================
# BhashaSetu - Environment Variables Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Fill in the required local configuration and API credentials.
# 3. NEVER commit your actual '.env' file to version control.
# =============================================================================

# --- Application Server Configuration ---
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
SECRET_KEY=generate_a_secure_random_key_for_production_use

# --- CORS & Security ---
# Comma-separated list of origins allowed to make cross-origin requests
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# --- Database Configuration ---
# Default to local SQLite for lightweight local development
DATABASE_URL=sqlite:///./database/bhashasetu.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/bhashasetu

# --- Storage & Model Paths ---
MODELS_CACHE_DIR=../models
DATA_DIR=../data

# --- AI & External API Credentials (Optional / Step 1+) ---
# Note: DO NOT put real keys in this example template file.
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_ID=your_pipeline_id_here
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here
